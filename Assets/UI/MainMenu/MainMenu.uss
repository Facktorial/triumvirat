/* ===========================================================
   Palette — swap these if you want a different accent than red
   =========================================================== */

:root {
    --clr-bg: rgb(10, 10, 10);
    --clr-fg: rgb(228, 228, 228);
    --clr-fg-dim: rgb(120, 120, 120);
    --clr-accent: rgb(196, 30, 30);
    --clr-accent-dim: rgba(196, 30, 30, 0.12);
    --clr-border: rgb(40, 40, 40);
}

/* ===========================================================
   Root
   =========================================================== */

.menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    /* background-color: rgb(10, 10, 10); */
    background-color: rgb(0, 146, 70);
    flex-direction: column;
    justify-content: flex-end;
}

.bg-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 0.015);
}

/* ===========================================================
   Header / eyebrow block, top-left
   =========================================================== */

.header-block {
    position: absolute;
    left: 80px;
    top: 60px;
    flex-direction: column;
}

.eyebrow-label {
    color: rgb(228, 228, 228);
    font-size: 12px;
    letter-spacing: 3px;
    -unity-text-align: upper-left;
    margin-bottom: 2px;
}

.eyebrow-label--dim {
    color: rgb(228, 228, 228);
}

/* ===========================================================
   Title block
   =========================================================== */

.title-block {
    padding-left: 80px;
    margin-bottom: 48px;
}

.title-label {
    color: rgb(240, 240, 240);
    font-size: 64px;
    letter-spacing: 6px;
    -unity-font-style: bold;
}

.subtitle-label {
    color: rgb(120, 120, 120);
    font-size: 14px;
    letter-spacing: 5px;
    margin-top: 4px;
}

/* ===========================================================
   Menu list
   =========================================================== */

.menu-list {
    flex-direction: column;
    padding-left: 80px;
    margin-bottom: 100px;
}

.menu-item {
    flex-direction: row;
    align-items: center;
    height: 46px;
    border-left-width: 2px;
    border-left-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    padding-left: 16px;
    margin-bottom: 2px;
    transition-property: border-left-color, background-color;
    transition-duration: 0.08s;
}

.menu-item__index {
    color: rgb(90, 90, 90);
    font-size: 12px;
    letter-spacing: 1px;
    margin-right: 14px;
    width: 24px;
}

.menu-item__label {
    color: rgb(228, 228, 228);
    font-size: 20px;
    letter-spacing: 3px;
}

/* Selected / hovered state — the single accent moment */
.menu-item--selected {
    border-left-color: rgb(196, 30, 30);
    background-color: rgba(196, 30, 30, 0.90);
}

.menu-item--selected .menu-item__index {
    color: rgb(206, 46, 55);
}

.menu-item--selected .menu-item__label {
    color: rgb(255, 255, 255);
}

/* Disabled item, e.g. CONTINUE with no save present */
.menu-item--disabled .menu-item__label {
    color: rgb(70, 70, 70);
}

.menu-item--disabled .menu-item__index {
    color: rgb(55, 55, 55);
}

/* ===========================================================
   Footer
   =========================================================== */

.footer-block {
    position: absolute;
    right: 60px;
    bottom: 40px;
    flex-direction: column;
    align-items: flex-end;
}

.footer-label {
    color: rgb(90, 90, 90);
    font-size: 11px;
    letter-spacing: 2px;
    margin-top: 2px;
}

.footer-label--accent {
    color: rgb(196, 30, 30);
}
