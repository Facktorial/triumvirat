.score-counter {
    /* position/top/left/right/bottom are set at runtime by ScoreCounterController
       via HudPositioning, so the same prefab can be placed at any corner
       per instance without editing this file. */
    flex-direction: row;
}

.score-digit {
    width: 28px;
    height: 36px;
    margin-right: 2px;
    -unity-background-scale-mode: scale-to-fit;
    /* background-image is assigned at runtime by ScoreCounterController */
}
